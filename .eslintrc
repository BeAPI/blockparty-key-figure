{
	"extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
	"env": {
		"browser": true,
		"node": true,
		"es6": true
	},
	"parserOptions": {
		"ecmaVersion": 12,
		"sourceType": "module"
	},
	"globals": {
		"jQuery": true,
		"wp": true
	},
	"settings": {
		"import/resolver": "node"
	},
	"rules": {
		"import/no-unresolved": [
			"error",
			{ "ignore": [ "^@wordpress/" ] }
		]
	},
	"overrides": [
		{
			"files": [ "src/**/*.js" ],
			"rules": {
				"import/no-extraneous-dependencies": "off"
			}
		}
	]
}
